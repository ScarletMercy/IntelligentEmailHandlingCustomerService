# AI Email Handler 配置文件
# 运行 'ai-email setup' 交互式生成，或手动复制本文件为 .env 并填写。

# AI 模型（必填）
API_KEY=
BASE_URL=
MODEL=

# QQ 邮箱（必填）
QQEMAIL=
EMAIL_PASSWORD=

# QQ Bot 通知（可选，不填则不启用）
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_NOTIFY_TARGET=

# 运行时行为（可选，括号内为默认值）
WORKER_CONCURRENCY=4        # 并发处理邮件的 worker 数
LLM_TIMEOUT_SECONDS=60      # LLM 调用超时（SDK 默认 600 秒过长）
RETRY_BACKOFF_SECONDS=30    # 失败邮件重试退避秒数
LOG_LEVEL=INFO              # 日志级别（DEBUG/INFO/WARNING/ERROR）
